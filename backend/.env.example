CORTEX_MODEL=claude-3-5-sonnet
CORTEX_EMBEDDING_MODEL=snowflake-arctic-embed-m-v1.5
CORTEX_TIMEOUT_MS=10000
CORTEX_MAX_ATTEMPTS=3
