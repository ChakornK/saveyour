PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8080
APP_ENV=development
MONGO_URI=mongodb://mongo:27017/saveyour-tech
MONGO_DATABASE=saveyour-tech
WORKER_CONCURRENCY=2
REDIS_URL=redis://redis:6379
CORTEX_ANALYSIS_ENABLED=true
CORTEX_TRANSCRIPTION_ENABLED=true
SEARCH_URL=http://meilisearch:7700
SEARCH_INDEX=saveyour-posts
SEARCH_API_KEY=change-this-meilisearch-key
SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_BUCKET=saveyour-tech
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
MEDIA_MAX_BYTES=26214400
REQUEST_TIMEOUT_MS=10000
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=10000
GEMINI_MAX_ATTEMPTS=3
AUTH_REQUIRED=false
# Google OAuth server configuration
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
